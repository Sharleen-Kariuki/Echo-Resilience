PORT=5002
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/echoresilience
CORS_ORIGIN=http://localhost:3000

# ─── SMS (fallback channel) — Africa's Talking ─────────────────────────────
# SMS_PROVIDER: "mock" or "africastalking"
SMS_PROVIDER=mock

# Sandbox username is literally "sandbox"; get an API key from
# https://account.africastalking.com/ (sandbox app, no card required).
#
# IMPORTANT — sandbox behavior:
#   - Sandbox SMS is delivered to the Africa's Talking Simulator in your
#     dashboard, NOT to a real phone, no matter what number you send to.
#   - The "phoneNumbers" the dispatch-sms endpoint expects are required by
#     the send API's shape, but in sandbox mode they're simulated recipients
#     only — they don't need to be real community members' numbers.
#   - Going live later needs: a live (non-sandbox) Africa's Talking app,
#     live credentials + an airtime/SMS top-up, and a real recipient/phone
#     table to source numbers from instead of a manual list.
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-sandbox-api-key
# Leave blank to use the sandbox's default alphanumeric sender
AT_SENDER_ID=

# ─── Voice (target channel) — Twilio ───────────────────────────────────────
# VOICE_PROVIDER: "mock" or "twilio"
VOICE_PROVIDER=mock

# From https://console.twilio.com/ (Account Info panel).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# This module's OWN public URL — Twilio calls back to
# {VOICE_CALLBACK_BASE_URL}/api/ivr/voice-callback and .../voice-status-callback
# to fetch TwiML and report call status. Twilio's servers cannot reach
# localhost, so in development this MUST be a public tunnel, e.g.:
#   ngrok http 5002
# then set this to the printed https://<subdomain>.ngrok.io URL.
VOICE_CALLBACK_BASE_URL=http://localhost:5002

# Twilio has essentially no local Kenyan Voice-capable number inventory —
# buy a US/UK number instead (it can still call +254 numbers), and make sure
# Voice → Settings → Geo Permissions has Kenya enabled for outbound calls.
# On a trial account, you can only call phone numbers you've verified
# (Twilio console → Verified Caller IDs) — no business KYC required, just a
# one-time OTP confirmation per number, unlike Africa's Talking Voice.

# Optional for later Python AI/NLP integration
NLP_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=dev-secret-key

# Base URL of the main backend (backend/) that serves AI-generated .wav
# files at alert_history.audio_url (a relative path). Used to build the
# absolute <Play> URL the voice callback hands to Twilio. For a real live
# call, this must also be a publicly reachable URL, not localhost.
MAIN_API_BASE_URL=http://localhost:5001

# Voice/SMS provider selection and voicePhoneNumber live in env/DB
# respectively: voicePhoneNumber is operational config an admin should be
# able to change, so it lives in the ivr_config DB table (see README), not
# here. TWILIO_ACCOUNT_SID/AUTH_TOKEN and AT_USERNAME/AT_API_KEY above are
# the only credentials, and they stay in .env.
