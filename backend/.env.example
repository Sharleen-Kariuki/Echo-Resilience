# ─── Database ────────────────────────────────────────────────
# Same PostgreSQL URL as database/.env
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/echoresilience

# ─── Auth ─────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ─── Server ───────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend URLs (Vite default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ─── IVR Service Link ─────────────────────────────────────────
IVR_SERVICE_URL=http://localhost:5002

# ─── AI Pipeline ──────────────────────────────────────────────
# Passed through to the Python subprocess (if not loaded from AI/.env)
GEMINI_API_KEY=your-gemini-api-key-here

# Python executable — change to 'python3' or 'py' if needed
PYTHON_CMD=python
