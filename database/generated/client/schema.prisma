datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Multiple sibling packages (backend/, backend_ivr_module/) point their
  // own prisma:generate script at this shared schema, but there are no npm
  // workspaces tying their node_modules together. Without an explicit
  // output path, Prisma always generates into node_modules/@prisma/client
  // next to *this* schema file (i.e. database/node_modules/@prisma/client)
  // no matter which package's script invoked it — so a bare `@prisma/client`
  // import from another package would resolve to its own, never-generated
  // copy and crash at runtime. Generating to one fixed, explicit path that
  // every consumer imports via a relative path sidesteps that entirely.
  output   = "../generated/client"
}

// 1. USER ROLES ENUM
enum user_role {
  superadmin
  admin
  viewer
}

// 1. USERS TABLE
model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         user_role @default(viewer)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  alerts       Alert[]   @relation("UserAlerts")

  @@map("users")
}

// 2. REGIONS TABLE
model Region {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(100)
  latitude         Float?
  longitude        Float?
  communities      Community[]
  alertRegions     AlertRegion[]
  alertHistory     AlertHistory[]
  feedbackLogs     FeedbackLog[]
  communityMembers CommunityMember[]

  @@map("regions")
}

// 3. HAZARD TYPES TABLE
model HazardType {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  alerts       Alert[]
  feedbackLogs FeedbackLog[]

  @@map("hazard_types")
}

// 4. COMMUNITIES TABLE
model Community {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(150)
  totalRegistered  Int               @default(0) @map("total_registered")
  regionId         Int               @map("region_id")
  region           Region            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  registrationDate DateTime          @default(now()) @map("registration_date") @db.Date
  source           String?           @db.VarChar(100)
  status           String?           @default("active") @db.VarChar(50)
  actions          String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  members          CommunityMember[]

  @@index([regionId], map: "idx_communities_region")
  @@map("communities")
}

// 5. ALERTS TABLE
model Alert {
  id                       Int            @id @default(autoincrement())
  hazardTypeId             Int            @map("hazard_type_id")
  hazardType               HazardType     @relation(fields: [hazardTypeId], references: [id], onDelete: Restrict)
  severityLevel            String         @map("severity_level") @db.VarChar(50)
  rawScientificDescription String         @map("raw_scientific_description") @db.Text
  createdByUserId          Int?           @map("created_by_user_id")
  createdByUser            User?          @relation("UserAlerts", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz
  alertRegions             AlertRegion[]
  alertHistory             AlertHistory[]

  @@index([hazardTypeId], map: "idx_alerts_hazard")
  @@map("alerts")
}

// 6. ALERT REGIONS (Many-to-Many Bridge Table)
model AlertRegion {
  alertId  Int    @map("alert_id")
  alert    Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([alertId, regionId])
  @@map("alert_regions")
}

// 7. ALERT HISTORY TABLE
model AlertHistory {
  id             Int           @id @default(autoincrement())
  alertId        Int           @map("alert_id")
  alert          Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  regionId       Int           @map("region_id")
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  dialect        String        @db.VarChar(100)
  status         String        @default("pending") @db.VarChar(50)
  callsCount     Int           @default(0) @map("calls_count")
  dispatchedAt   DateTime      @default(now()) @map("dispatched_at") @db.Timestamptz
  // AI pipeline output — populated by the backend after calling the AI module
  simplifiedText String?       @map("simplified_text") @db.Text
  translatedText String?       @map("translated_text") @db.Text
  audioUrl       String?       @map("audio_url") @db.Text
  feedbackLogs   FeedbackLog[]
  callAttempts   CallAttempt[]

  @@index([alertId], map: "idx_alert_history_alert")
  @@map("alert_history")
}

// 8. FEEDBACK LOGS TABLE
model FeedbackLog {
  id               Int          @id @default(autoincrement())
  alertHistoryId   Int          @map("alert_history_id")
  alertHistory     AlertHistory @relation(fields: [alertHistoryId], references: [id], onDelete: Cascade)
  regionId         Int          @map("region_id")
  region           Region       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  hazardTypeId     Int          @map("hazard_type_id")
  hazardType       HazardType   @relation(fields: [hazardTypeId], references: [id], onDelete: Restrict)
  audioFeedbackUrl String?      @map("audio_feedback_url") @db.Text
  translationText  String?      @map("translation_text") @db.Text
  status           String       @default("pending") @db.VarChar(50)
  adminResponse    String?      @map("admin_response") @db.Text
  respondedAt      DateTime?    @map("responded_at") @db.Timestamptz
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([alertHistoryId], map: "idx_feedback_logs_history")
  @@map("feedback_logs")
}

// 9. COMMUNITY MEMBERS TABLE
// Individual registered recipients — this is the actual phone-number roster
// that a broadcast (voice or SMS) dispatches to. `communities`/`regions` are
// aggregate/organizational rows and never stored a phone number themselves;
// this table is what closes that gap.
model CommunityMember {
  id           Int           @id @default(autoincrement())
  fullName     String?       @map("full_name") @db.VarChar(255)
  phoneNumber  String        @map("phone_number") @db.VarChar(32)
  regionId     Int           @map("region_id")
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  communityId  Int?          @map("community_id")
  community    Community?    @relation(fields: [communityId], references: [id], onDelete: SetNull)
  language     String?       @db.VarChar(50)
  dialect      String?       @db.VarChar(100)
  isActive     Boolean       @default(true) @map("is_active")
  consent      Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  callAttempts CallAttempt[]

  @@index([regionId], map: "idx_community_members_region")
  @@index([communityId], map: "idx_community_members_community")
  @@index([phoneNumber], map: "idx_community_members_phone")
  @@map("community_members")
}

// 10. CALL ATTEMPTS TABLE (a.k.a. broadcast recipients)
// One row per (alert_history, recipient) dispatch attempt — voice by default,
// SMS when voice isn't available. Tracks each recipient's outcome
// individually so alert_history can report an honest dispatched/failed/
// partial rollup instead of a single opaque calls_count.
model CallAttempt {
  id             Int              @id @default(autoincrement())
  alertHistoryId Int              @map("alert_history_id")
  alertHistory   AlertHistory     @relation(fields: [alertHistoryId], references: [id], onDelete: Cascade)
  memberId       Int?             @map("member_id")
  member         CommunityMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  phoneNumber    String           @map("phone_number") @db.VarChar(32)
  channel        String           @default("voice") @db.VarChar(20)
  status         String           @default("pending") @db.VarChar(50)
  provider       String?          @db.VarChar(50)
  providerCallId String?          @map("provider_call_id") @db.VarChar(100)
  language       String?          @db.VarChar(50)
  dialect        String?          @db.VarChar(100)
  attemptCount   Int              @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?        @map("last_attempt_at") @db.Timestamptz
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz
  failureReason  String?          @map("failure_reason") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([alertHistoryId], map: "idx_call_attempts_alert_history")
  @@index([memberId], map: "idx_call_attempts_member")
  @@index([status], map: "idx_call_attempts_status")
  @@map("call_attempts")
}

// 11. IVR CONFIG TABLE
// Single active row describing which provider/hotline is live. No API keys
// live here — those stay in .env (AT_USERNAME/AT_API_KEY) on the server that
// calls the provider. This table is operational config only (which number,
// which provider, on/off), safe to read from an admin UI.
model IvrConfig {
  id               Int      @id @default(autoincrement())
  provider         String   @default("africastalking") @db.VarChar(50)
  voicePhoneNumber String?  @map("voice_phone_number") @db.VarChar(32)
  defaultLanguage  String?  @map("default_language") @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ivr_config")
}
