datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. USER ROLES ENUM
enum user_role {
  superadmin
  admin
  viewer
}

// 1. USERS TABLE
model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         user_role @default(viewer)
  lastLogin    DateTime? @map("last_login") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  alerts       Alert[]   @relation("UserAlerts")

  @@map("users")
}

// 2. REGIONS TABLE
model Region {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  latitude     Float?
  longitude    Float?
  communities  Community[]
  members      Member[]
  alertRegions AlertRegion[]
  alertHistory AlertHistory[]
  feedbackLogs FeedbackLog[]

  @@map("regions")
}

// 3. HAZARD TYPES TABLE
model HazardType {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  alerts       Alert[]
  feedbackLogs FeedbackLog[]

  @@map("hazard_types")
}

// 4. COMMUNITIES TABLE
model Community {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(150)
  totalRegistered  Int      @default(0) @map("total_registered")
  type             String?  @db.VarChar(50)
  leaderPhone      String?  @map("leader_phone") @db.VarChar(20)
  regionId         Int      @map("region_id")
  region           Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  registrationDate DateTime @default(now()) @map("registration_date") @db.Date
  source           String?  @db.VarChar(100)
  status           String?  @default("active") @db.VarChar(50)
  actions          String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  members          Member[]

  @@index([regionId], map: "idx_communities_region")
  @@map("communities")
}

// Individual recipients registered through the Communities page.
model Member {
  id          Int        @id @default(autoincrement())
  fullName    String     @map("full_name") @db.VarChar(255)
  phone       String     @unique @db.VarChar(20)
  language    String     @db.VarChar(100)
  locality    String?    @db.VarChar(150)
  source      String?    @db.VarChar(100)
  status      String     @default("active") @db.VarChar(50)
  regionId    Int        @map("region_id")
  region      Region     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  communityId Int?       @map("community_id")
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([regionId], map: "idx_members_region")
  @@index([communityId], map: "idx_members_community")
  @@map("members")
}

// 5. ALERTS TABLE
model Alert {
  id                       Int            @id @default(autoincrement())
  hazardTypeId             Int            @map("hazard_type_id")
  hazardType               HazardType     @relation(fields: [hazardTypeId], references: [id], onDelete: Restrict)
  severityLevel            String         @map("severity_level") @db.VarChar(50)
  rawScientificDescription String         @map("raw_scientific_description") @db.Text
  createdByUserId          Int?           @map("created_by_user_id")
  createdByUser            User?          @relation("UserAlerts", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz
  alertRegions             AlertRegion[]
  alertHistory             AlertHistory[]

  @@index([hazardTypeId], map: "idx_alerts_hazard")
  @@map("alerts")
}

// 6. ALERT REGIONS (Many-to-Many Bridge Table)
model AlertRegion {
  alertId  Int    @map("alert_id")
  alert    Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([alertId, regionId])
  @@map("alert_regions")
}

// 7. ALERT HISTORY TABLE
model AlertHistory {
  id             Int           @id @default(autoincrement())
  alertId        Int           @map("alert_id")
  alert          Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  regionId       Int           @map("region_id")
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  dialect        String        @db.VarChar(100)
  status         String        @default("pending") @db.VarChar(50)
  callsCount     Int           @default(0) @map("calls_count")
  dispatchedAt   DateTime      @default(now()) @map("dispatched_at") @db.Timestamptz
  // AI pipeline output — populated by the backend after calling the AI module
  simplifiedText String?       @map("simplified_text") @db.Text
  translatedText String?       @map("translated_text") @db.Text
  audioUrl       String?       @map("audio_url") @db.Text
  feedbackLogs   FeedbackLog[]

  @@index([alertId], map: "idx_alert_history_alert")
  @@map("alert_history")
}

// 8. FEEDBACK LOGS TABLE
model FeedbackLog {
  id             Int          @id @default(autoincrement())
  alertHistoryId Int          @map("alert_history_id")
  alertHistory   AlertHistory @relation(fields: [alertHistoryId], references: [id], onDelete: Cascade)
  regionId       Int          @map("region_id")
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  hazardTypeId   Int          @map("hazard_type_id")
  hazardType     HazardType   @relation(fields: [hazardTypeId], references: [id], onDelete: Restrict)
  audioFeedbackUrl String?    @map("audio_feedback_url") @db.Text
  translationText  String?    @map("translation_text") @db.Text
  status         String       @default("pending") @db.VarChar(50)
  adminResponse  String?      @map("admin_response") @db.Text
  respondedAt    DateTime?    @map("responded_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([alertHistoryId], map: "idx_feedback_logs_history")
  @@map("feedback_logs")
}
