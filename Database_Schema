 Create custom Enum for User Roles (Optional, but ensures consistency)
CREATE TYPE user_role AS ENUM ('superadmin', 'admin');

-- 1. USERS TABLE
CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role user_role NOT NULL DEFAULT 'viewer',
    last_login TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 2. REGIONS TABLE (Lookup)
CREATE TABLE regions (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL
);

-- 3. HAZARD TYPES TABLE (Lookup)
CREATE TABLE hazard_types (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL
);

-- 4. COMMUNITIES TABLE
CREATE TABLE communities (
    id SERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    total_registered INTEGER DEFAULT 0 CHECK (total_registered >= 0),
    region_id INTEGER NOT NULL REFERENCES regions(id) ON DELETE RESTRICT,
    registration_date DATE DEFAULT CURRENT_DATE,
    source VARCHAR(100),
    status VARCHAR(50) DEFAULT 'active',
    actions TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 5. ALERTS TABLE
CREATE TABLE alerts (
    id SERIAL PRIMARY KEY,
    hazard_type_id INTEGER NOT NULL REFERENCES hazard_types(id) ON DELETE RESTRICT,
    severity_level VARCHAR(50) NOT NULL, -- e.g., Low, Medium, High
    raw_scientific_description TEXT NOT NULL,
    created_by_user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE SET NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 6. ALERT REGIONS (Many-to-Many Bridge Table)
CREATE TABLE alert_regions (
    alert_id INTEGER REFERENCES alerts(id) ON DELETE CASCADE,
    region_id INTEGER REFERENCES regions(id) ON DELETE CASCADE,
    PRIMARY KEY (alert_id, region_id)
);

-- 7. ALERT HISTORY TABLE
CREATE TABLE alert_history (
    id SERIAL PRIMARY KEY,
    alert_id INTEGER NOT NULL REFERENCES alerts(id) ON DELETE CASCADE,
    region_id INTEGER NOT NULL REFERENCES regions(id) ON DELETE RESTRICT,
    dialect VARCHAR(100) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'pending', -- e.g., Pending, Dispatched, Failed
    calls_count INTEGER DEFAULT 0 CHECK (calls_count >= 0),
    dispatched_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- 8. FEEDBACK LOGS TABLE
CREATE TABLE feedback_logs (
    id SERIAL PRIMARY KEY,
    alert_history_id INTEGER NOT NULL REFERENCES alert_history(id) ON DELETE CASCADE,
    region_id INTEGER NOT NULL REFERENCES regions(id) ON DELETE RESTRICT,
    hazard_type_id INTEGER NOT NULL REFERENCES hazard_types(id) ON DELETE RESTRICT,
    audio_feedback_url TEXT, -- Link to file storage path (S3, Cloud Storage, etc.)
    translation_text TEXT,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
);

-- OPTIONAL PERFORMANCE INDEXES
-- Indexing foreign keys frequently used in JOINs to speed up dashboard queries
CREATE INDEX idx_communities_region ON communities(region_id);
CREATE INDEX idx_alerts_hazard ON alerts(hazard_type_id);
CREATE INDEX idx_alert_history_alert ON alert_history(alert_id);
CREATE INDEX idx_feedback_logs_history ON feedback_logs(alert_history_id);